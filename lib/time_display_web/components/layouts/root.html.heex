<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <!-- F O N T S -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Nova+Mono&family=Space+Grotesk:wght@300..700&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

    <.live_title default="TimeDisplay" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <title>Time Display</title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2E8D5] text-black justify-between px-3 py-2.5 bg-[radial-gradient(circle,#1e1a4d2A_3px,transparent_3px)] bg-size-[40px_40px]">
    
    <header class="flex font-space-grotesk justify-between text-[0.89rem] text-indigo-950 font-semibold items-baseline tracking-wider h-7">
      <.stopwatch /> <!-- left -->
      <.timer />  <!-- right -->
    </header>


    {@inner_content}


    <footer class="flex justify-between font-spline-mono font-[550] text-[0.9rem] tracking-wide items-baseline cursor-default select-none">
      <.switch_clock_btns /> <!-- left -->
      <.date_of_completion /> <!-- right -->
    </footer>
  </body>
</html>
