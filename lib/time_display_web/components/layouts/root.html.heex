<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <!-- F O N T S -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Nova+Mono&family=Space+Grotesk:wght@300..700&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

    <.live_title default="TimeDisplay" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <title>Time Display</title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2E8D5] text-black justify-between px-3 py-2.5 bg-[radial-gradient(circle,#1e1a4d2A_3px,transparent_3px)] bg-size-[40px_40px]">
    
    <header class="flex font-space-grotesk justify-between text-[0.89rem] text-indigo-950 font-semibold items-baseline tracking-wider">
      <section class="relative">
        <button id="stopwatch-btn" class="mx-auto block select-none cursor-pointer border-[1.5px] bg-white/15 px-1.5 rounded-[3px]">stopwatch</button>
        <div class="absolute border w-full">
          <div class="font-bold text-center tracking-widest rounded-full pt-[0.5px] mt-2 bg-indigo-950/15 w-21 mx-auto">00:00:00</div>
          <div id="stopwatch-controls" class="select-none flex text-xs mt-2 justify-center gap-x-2 mr-1">
            <button id="unpause" class="cursor-pointer bg-indigo-950/20 rounded-full pl-[4.5px] pr-[1.25px] hover:bg-indigo-950/70 hover:text-white ease-hover">▶︎</button>
            <button id="pause" class="cursor-pointer bg-indigo-950/20 rounded-full pl-[2.75px] pr-[2px] pt-[0.75px] pb-[0.25px] hover:bg-indigo-950/70 hover:text-white ease-hover">❚❚</button>
            <button id="stop" class="cursor-pointer bg-indigo-950/20 rounded-full pl-[2.75px] pr-[2px] pt-[0.5px] pb-[0.5px] hover:bg-indigo-950/70 hover:text-white ease-hover">◼</button>
          </div>
        </div>
      </section>

      <section class="relative">
        <button id="timer-btn" class="mx-auto block select-none cursor-pointer border-[1.5px] bg-white/15 px-1.5 rounded-[3px]">timer</button>

        <div id="timer-input" class="border-[1.5px] bg-white/15 px-1.5 rounded-[3px] flex items-center pt-0.5 pb-0.75">
          <input id="input-minute" type="text" class="bg-white/60 h-5 rounded-[3px] pt-px w-7 text-center placeholder:text-[0.75rem] placeholder:-pt-2 placeholder:font-extrabold" value="00" maxlength="2" placeholder="MM">
          <p class="select-none pl-0.5 pt-px pr-1 font-extrabold">m</p>
          <input id="input-second" type="text" class="bg-white/60 h-5 rounded-[3px] pt-px w-7 text-center placeholder:text-[0.8rem] placeholder:-pt-2 placeholder:font-extrabold" value="00" maxlength="2" placeholder="SS">
          <p class="select-none pl-0.75 pr-4 pt-[0.5px] font-extrabold text-[0.94rem]">s</p>
          <button class="select-none cursor-pointer bg-indigo-950/15 hover:bg-indigo-950/70 hover:text-white ease-hover pl-[4.5px] pr-[4px] rounded-full">✔</button>
        </div>

        <div class="absolute border w-full">
          <div class="font-bold text-center tracking-widest rounded-full pt-[0.5px] mt-2 w-15 mx-auto bg-indigo-950/15">00:00</div>
          <div id="timer-controls" class="flex text-xs mt-2 justify-center gap-x-2 mr-1 select-none">
            <button id="unpause" class="cursor-pointer bg-indigo-950/20 rounded-full pl-[4.5px] pr-[1.25px] hover:bg-indigo-950/70 hover:text-white ease-hover">▶︎</button>
            <button id="pause" class="cursor-pointer bg-indigo-950/20 rounded-full pl-[2.75px] pr-[2px] pt-[0.75px] pb-[0.25px] hover:bg-indigo-950/70 hover:text-white ease-hover">❚❚</button>
            <button id="stop" class="cursor-pointer bg-indigo-950/20 rounded-full pl-[2.75px] pr-[2px] pt-[0.5px] pb-[0.5px] hover:bg-indigo-950/70 hover:text-white ease-hover">◼</button>
          </div>
          <div id="timer-complete" class="text-[0.7rem] border rounded-xs w-fit mx-auto px-1 pt-[0.5px] mt-1.5"><span class="select-none">DONE: </span>15:59</div>

        </div>
      </section>
    </header>


    {@inner_content}


    <footer class="flex justify-between font-spline-mono font-[550] text-[0.9rem] tracking-wide items-baseline cursor-default select-none">
      <.switch_clock_btns /> <!-- left -->
      <.date_of_completion /> <!-- right -->
    </footer>
  </body>
</html>
