<Layouts.flash_group flash={@flash} />
<main class="m-auto">

  <!-- analog clock -->
  <section id="analog-format" class="hidden font-nova-mono p-1 border-[1.5px] border-black/85 bg-[#F2E8D5] rounded-full">
    <div class="clock relative w-75 h-75 rounded-full border-7 border-black/70 select-none cursor-pointer bg-[#F2E8D5] hover:text-white hover:bg-[#6a6a6a] ease-hover">
      <.analog_clock_numbers />
      <.analog_clock_graduations />
      <.analog_clock_hands />
      <.analog_digital_display />
    </div>
  </section>


  <!-- digital clock -->
  <section id="digital-format" class="hidden w-[calc(100%-5px)] relative">

    <div class="wrapper flex font-space-grotesk text-8xl tracking-[0.4rem] font-bold select-none">
      <.timezone_city />
      <.digital_clock />
      <.time_period />
    </div>


    <% # hour_format_btns component %>
    <div class="flex font-space-grotesk justify-between px-7 text-[0.89rem] font-extrabold items-center tracking-wider">
      <button id="24h-btn" class="border-[1.5px] px-1.5 rounded-[3px] z-1 ease-hover">24h clock</button>
      <button id="12h-btn" class="border-[1.5px] px-1.5 pt-px rounded-[3px] z-1 ease-hover">12h clock</button>
    </div>
  </section>

</main>
