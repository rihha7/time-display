<Layouts.flash_group flash={@flash} />
<main class="m-auto">

  <!-- analog component for time_components.ex -->


  <!-- digital component for time_components.ex -->
  <section class="border">
    <div class="wrapper flex font-space-grotesk text-8xl tracking-[0.4rem] font-bold select-none">
      <!-- time segments -->
      <div class="relative [&:has(.hover-target:hover)>h1]:text-transparent [&:has(.hover-target:hover)>h1]:[-webkit-text-stroke:2.1px_black]">
        <div class="absolute hover-target left-1/2 -translate-x-1/2 w-[7.65rem] top-1/2 -translate-y-1/2 -ml-0.75 h-[4.5rem] cursor-pointer bg-amber-200/50 rounded-xl"></div>
        <h1>00</h1>
      </div>


      <!-- separators -->
      <h1 id="segment-separator" class="-mt-1.5">:</h1>


      <div class="relative [&:has(.hover-target:hover)>h1]:text-transparent [&:has(.hover-target:hover)>h1]:[-webkit-text-stroke:2.1px_black]">
        <div class="absolute hover-target left-1/2 -translate-x-1/2 w-[7.65rem] top-1/2 -translate-y-1/2 -ml-0.75 h-[4.5rem] cursor-pointer bg-amber-200/50 rounded-xl"></div>
        <h1>00</h1>
      </div>


      <h1 id="segment-separator" class="-mt-1.5">:</h1>


      <div class="relative [&:has(.hover-target:hover)>h1]:text-transparent [&:has(.hover-target:hover)>h1]:[-webkit-text-stroke:2.1px_black]">
        <div class="absolute hover-target left-1/2 -translate-x-1/2 w-[7.65rem] top-1/2 -translate-y-1/2 -ml-0.75 h-[4.5rem] cursor-pointer bg-amber-200/50 rounded-xl"></div>
        <h1>00</h1>
      </div>
    </div>






    <div class="flex font-spline-mono justify-between px-7 border text-[0.9rem] tracking-wider font-medium items-center">
      <!-- first 2 p need to share same width -->
      <p id="timezone" class="border"></p>
      <p id="time-period" class="border w-20 font-[350] text-[1.1rem] select-none">PM</p> <!-- AM/PM/noon/midnight -->
      <p id="12h-time" class="border tracking-widest">01:00</p> <!-- 12h format -->
    </div>
  </section>


</main>
